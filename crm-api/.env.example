# ─── Application ───────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0

# ─── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=g4s_crm
DB_USER=g4s_app
DB_PASSWORD=devpassword
DB_SSLMODE=disable

# ─── Redis (optional) ──────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ───────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_REFRESH_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ─── File Storage ──────────────────────────────────────────
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE=52428800

# ─── Email (SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=crm@g4s.com
SMTP_PASS=your-smtp-password
SMTP_FROM=G4S CRM <crm@g4s.com>

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FILE=

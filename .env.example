# ─── Full-Stack Docker Compose Config ─────────────────────
# Copy to .env and edit before running docker compose up

APP_ENV=production
LOG_LEVEL=info

# Database password (used by both postgres and api services)
DB_PASSWORD=change-me-strong-password

# JWT
JWT_REFRESH_SECRET=change-me-long-random-secret-for-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Port the frontend is exposed on the host
FRONTEND_PORT=80

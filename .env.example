# ─── Full-Stack Docker Compose Config ─────────────────────
# Copy to .env and edit before running docker compose up

APP_ENV=production
LOG_LEVEL=info

# Database password (used by both postgres and api services).
# The API refuses to start in production with a change-me value.
# Generate one with: openssl rand -hex 24
DB_PASSWORD=change-me

# JWT refresh secret: at least 32 random characters.
# Generate one with: openssl rand -hex 32
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Port the frontend is exposed on the host
FRONTEND_PORT=80

# Optional banner shown on every page, e.g. "Test environment". Leave empty
# on the real production server.
ENVIRONMENT_LABEL=

# Other websites allowed to call the API from a browser, comma-separated.
# Leave empty: the app and API share one address through nginx.
CORS_ALLOWED_ORIGINS=
